# Version control and editor metadata
.git/
.gitignore
.gitattributes
.github/
.vscode/
.idea/

# Python bytecode, tests and tool caches
__pycache__/
**/__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.pytype/
.tox/
.nox/

# Local Python environments, secrets and caches
.venv/
venv/
env/
.env/
.env.*
!.env.example
.cache/
pip-cache/

# Runtime data, backups and logs
backups/
db_backups/
storage/
*.dump
*.sql
*.log
*.log.*
*.pid

# TLS / Certbot state: mounted from the host; never bake it into the app image
certbot/conf/
certbot/www/

# Node and frontend artifacts
node_modules/
**/node_modules/
dist/
build/
coverage/

# OS and editor temporary files
.DS_Store
Thumbs.db
*.swp
*.swo
*~
tmp/
temp/